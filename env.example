# Frontend (Vite) — copy to .env
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Same value as Supabase Edge secret VAPID_PUBLIC_KEY (URL-safe base64 from web-push)
VITE_VAPID_PUBLIC_KEY=

# Generate a key pair (run locally, never commit private key):
#   npx web-push generate-vapid-keys
#
# Supabase Dashboard → Edge Functions → Secrets:
#   VAPID_PUBLIC_KEY   (same as VITE_VAPID_PUBLIC_KEY)
#   VAPID_PRIVATE_KEY  (private key only on server)
#   VAPID_SUBJECT      optional, default mailto:support@replyspot.app
